    <dashboard name='Story 1' type='storyboard'>
      <style />
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' preset-index='8' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='1' param='vert' removable='false' type-v2='layout-flow' w='99000' x='500' y='889'>
            <zone h='4667' id='3' type-v2='title' w='99000' x='500' y='889' />
            <zone h='11222' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99000' x='500' y='5556' />
            <zone h='82333' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99000' x='500' y='16778'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='COVID-19 had reached every populated continent, with the Americas and Europe carrying the largest case volumes.' captured-sheet='1_Global_Spread' id='1'>
                    <currentDeltas>
                      <worksheet name='1_Global_Spread'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1jjjfk61yeq5ef16581le111juhb].[Latitude (generated)]' field-type='quantitative' max='25198151.522254594' min='-17619466.801240571' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.1jjjfk61yeq5ef16581le111juhb].[Longitude (generated)]' field-type='quantitative' max='29624405.571042769' min='-53586077.95423153' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </currentDeltas>
                    <capturedDeltas />
                  </story-point>
                  <story-point caption='Europe&apos;s average death rate (4.2 per 100 cases) is over 3x higher than South-East Asia&apos;s (1.3).' captured-sheet='2_Regional_Death_Rate' id='2' />
                  <story-point caption='Countries in the lower-right — high death rate, below-average recovery — represent the highest concern despite large outbreaks elsewhere recovering well.' captured-sheet='3_Severity_vs_Recovery' id='3' />
                  <story-point caption='Papua New Guinea and Gambia show the sharpest week-over-week case growth — an early warning that doesn&apos;t yet show up in cumulative totals' captured-sheet='4_Fastest_Accelerating' id='4' />
                  <story-point caption='The Americas and Europe combine the largest outbreaks with above-average death rates — the worst possible combination.' captured-sheet='6_Region_Volume_vs_Severity' id='5' />
                  <story-point caption='&quot;Several countries have crossed 95%+ recovery rates even with large outbreaks, showing strong case management is achievable.' captured-sheet='7_Recovery_Leaders' id='6' />
                  <story-point caption='Yemen, the UK, and Belgium top the list for death rate — these should be the immediate focus for health resource prioritization.' captured-sheet='5_Top 10 Countries by Death Rate' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
