        <calculation class='tableau' formula='IF [Deaths / 100 Cases] &gt; 5 AND [1 week % increase] &gt; 15 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [Deaths / 100 Cases] &gt; 5 THEN &quot;High Fatality, Slowing&quot;&#13;&#10;ELSEIF [1 week % increase] &gt; 15 THEN &quot;Accelerating, Lower Fatality&quot;&#13;&#10;ELSE &quot;Stable&quot;&#13;&#10;END' />
